# ElectronicAI — local/dev environment. On the challenge VM these are already set.
# Never commit real values.

# VSS retrieval backend (the app authenticates server-side and calls the real APIs).
# On the VM these come from /config/<team>.config as INGRESS_URL/USERNAME/PASSWORD;
# the deploy Secret exposes them as VSS_URL/VSS_USERNAME/VSS_PASSWORD. Either works.
VSS_URL=https://<your-team-ingress-url>
VSS_USERNAME=team-x
VSS_PASSWORD=<password>

# Weights & Biases serverless inference (OpenAI-compatible) for the technician reasoning.
WANDB_API_KEY=<wandb-api-key>
WANDB_TEAM=<wandb-team>
WANDB_PROJECT=<wandb-project>
WANDB_BASE_URL=https://api.inference.wandb.ai/v1
# Set to a model your W&B project serves.
WANDB_MODEL=meta-llama/Llama-3.3-70B-Instruct

PORT=8080
HTTP_TIMEOUT=60
